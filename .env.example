[TEMPLATE]
# Cognitia Shield Environment Configuration
# Use public testnet or developer RPC URLs. Never commit private keys or secrets.

# ---- Read-only RPC endpoints (browser builds read VITE_* at build time) ----
VITE_ETHEREUM_RPC=https://eth.llamarpc.com
VITE_SEPOLIA_RPC=https://rpc.sepolia.org
VITE_BASE_RPC=https://mainnet.base.org
VITE_BASE_SEPOLIA_RPC=https://sepolia.base.org
VITE_POLYGON_RPC=https://polygon-rpc.com
VITE_AMOY_RPC=https://rpc-amoy.polygon.technology

# ---- Simulation backend (Part 3) ----
# Precedence: ANVIL fork first, then Sepolia, then mainnet. LIVE mode fails
# closed if the endpoint is unreachable or reports the wrong chain ID.
# Local Anvil fork: anvil --fork-url $MAINNET_RPC_URL
ANVIL_RPC_URL=
VITE_SIMULATION_FORK_RPC=
SEPOLIA_RPC_URL=
MAINNET_RPC_URL=
FORK_BLOCK_NUMBER=

# ---- Sepolia deployment (Part 14 — TESTNET ONLY) ----
# Used ONLY by `forge script script/DeploySepolia.s.sol` (contracts/).
# The key is never printed, logged, committed, or sent to the frontend.
SEPOLIA_RPC_URL_DEPLOY=
DEPLOYER_PRIVATE_KEY=
DEMO_OPERATOR=
DEMO_NFT_CONTRACT=
