{
  "manifest_version": 3,
  "name": "Nemesis — Web3 Transaction Firewall",
  "version": "1.0.1",
  "description": "Pre-execution transaction interceptor & malicious signature simulator. Simulates wallet requests before you sign and blocks drainer patterns.",
  "browser_specific_settings": {
    "gecko": {
      "id": "nemesis@cognitia-shield",
      "strict_min_version": "128.0"
    }
  },
  "permissions": ["storage", "activeTab", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "sidebar_action": {
    "default_title": "Nemesis — Command Center",
    "default_panel": "src/sidepanel/index.html"
  },
  "action": {
    "default_title": "Nemesis — Command Center",
    "default_popup": "src/popup/index.html"
  },
  "background": {
    "scripts": ["src/background/index.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["src/inject/interceptor.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["src/inject/interceptor.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
